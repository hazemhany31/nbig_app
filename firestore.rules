rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // Helper Functions
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDoctor() {
      // Allows anyone with a doctor profile to have doctor privileges 
      return isAuthenticated() && exists(/databases/$(database)/documents/doctors/$(request.auth.uid));
    }

    // ==========================================
    // 1. Chats Collection
    // ==========================================
    match /chats/{chatId} {
      // Allow read/update if user is a participant
      allow read, update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorUserId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid
      );
      
      // Allow create only if the user is one of the participants being added
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid || 
        request.resource.data.doctorUserId == request.auth.uid ||
        request.resource.data.doctorId == request.auth.uid
      );

      // No one can completely delete a chat map
      allow delete: if false;
      
      // --- Messages Subcollection ---
      match /messages/{messageId} {
        // Allow read/write only if the user is a participant of the parent chat
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.patientId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.doctorUserId == request.auth.uid ||
          get(/databases/$(database)/documents/chats/$(chatId)).data.doctorId == request.auth.uid
        );
      }
    }
    
    // ==========================================
    // 2. Doctors Collection
    // ==========================================
    match /doctors/{doctorId} {
      allow read: if isAuthenticated();
      
      // Allow doctor to update their own profile, OR allow any authenticated user to update ONLY specific non-sensitive fields
      // Matches doctor-app rules: prevents patients from overwriting doctor profile data
      allow update: if isUser(doctorId) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['patientsCount', 'rating', 'totalReviews'])
      );
      
      allow delete: if isUser(doctorId);
      allow create: if isUser(doctorId);
    }
    
    // ==========================================
    // 3. Appointments Collection
    // ==========================================
    match /appointments/{appointmentId} {
      // Must be the involved patient or doctor
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid ||
        resource.data.doctorUserId == request.auth.uid
      );
      
      // Must be involved to update
      allow update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid ||
        resource.data.doctorUserId == request.auth.uid
      );
      
      // Anyone authenticated can create if they set themselves as patient
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      
      allow delete: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || 
        resource.data.doctorId == request.auth.uid ||
        resource.data.doctorUserId == request.auth.uid
      );
    }
    
    // ==========================================
    // 4. Users Collection
    // ==========================================
    match /users/{userId} {
      // Users can read their own info, or doctors can read user profiles.
      allow read: if isUser(userId) || isDoctor(); 
      allow update: if isUser(userId);
      allow create: if isUser(userId);
      allow delete: if isUser(userId);

      // --- Medical Records Subcollection ---
      match /medical_records/{recordId} {
        // Patient can read/write their own records.
        // Doctors can read/write any medical records for now.
        allow read: if isUser(userId) || isDoctor();
        allow write: if isUser(userId) || isDoctor();
      }
    }

    // ==========================================
    // 5. Emergency Alerts Collection
    // ==========================================
    match /emergency_alerts/{alertId} {
      // Any patient can create an alert for themselves
      allow create: if isAuthenticated() && request.resource.data.patientId == request.auth.uid;
      
      // Patient who created it OR any doctor can read and update it.
      allow read, update: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid || isDoctor()
      );
      
      // Only patient can delete their own alert
      allow delete: if isAuthenticated() && resource.data.patientId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      // A user can read, update, or delete only their own notifications.
      // Use 'recipientId' as it matches the application's query filter.
      allow read, update, delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      // Anyone can create a notification for someone else.
      allow create: if isAuthenticated();
    }
    // ==========================================
    // 7. Donations Collection
    // ==========================================
    match /donations/{donationId} {
      // All authenticated users can read donations
      allow read: if isAuthenticated();
      
      // All authenticated users can create donations
      allow create: if isAuthenticated();
      
      // Allow update if user owns the donation OR is a doctor (for recommendations)
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.donorId == request.auth.uid ||
        isDoctor()
      );
      
      // Allow delete if user owns the donation
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.donorId == request.auth.uid
      );
    }
  }
}
