rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    
    // Profile Images - Users can upload their own profile images
    match /profile_images/{userId}/{allPaths=**} {
      // Anyone logged in can read profile images
      allow read: if request.auth != null;
      
      // Users can only write to their own profile image folder
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Users profile picture under users/ path
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Medical Records Uploads - Patient can read/write, verified doctors can read
    match /medical_records/{patientId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == patientId || (
          firestore.exists(/databases/(default)/documents/doctors/$(request.auth.uid)) &&
          firestore.get(/databases/(default)/documents/doctors/$(request.auth.uid)).data.isVerified == true
        )
      );
      allow write: if request.auth != null && request.auth.uid == patientId;
    }

    // Legacy uploads path
    match /uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Doctor Profile Images and Clinic Photos
    match /doctors/{doctorId}/{allPaths=**} {
      allow read: if true; // anyone can see doctor photos
      allow write: if request.auth != null && request.auth.uid == doctorId; // only that doctor can write
    }

    // Chat Attachments - secure path for peer-to-peer image transfers
    match /chats/{chatId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.patientId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/chats/$(chatId)).data.doctorUserId == request.auth.uid
      );
    }

    // Donations Uploads
    match /donations/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && filename.startsWith('donation_' + request.auth.uid + '_');
    }
  }
}
